{
  "name": "money-momentum",
  "main": "full-worker.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "../dist/cloudflare-full",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "preview_urls": false,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "money-momentum-private",
      "database_id": "a1223ad4-a6a3-42a2-a9fa-6685128c27d9"
    }
  ],
  "vars": {
    "FIREBASE_TOTP_MFA": "enabled",
    "FIREBASE_WEB_CONFIG": "{\"apiKey\":\"AIzaSyAa8Q9D8tyJBENVzlSWTSuvbYpkn-DkZg0\",\"authDomain\":\"money-momentum-f30aa.firebaseapp.com\",\"projectId\":\"money-momentum-f30aa\",\"appId\":\"1:914657467660:web:69b09622cbc44e29a6fd29\"}",
    "APP_ORIGIN": "https://money-momentum.budgetstudio.workers.dev",
    "PLAID_ENV": "production",
    "PLAID_REDIRECT_URI": "https://money-momentum.budgetstudio.workers.dev/account"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
